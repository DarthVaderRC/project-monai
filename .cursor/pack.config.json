{
  "pack": "monai",
  "schema_version": 1,
  "profile_env": "MONAI_CURSOR_BOUNDARY",
  "strict": {
    "prefixes": [
      ".cursor/",
      "docs/cursor-kit/",
      "monai/transforms/",
      "tests/transforms/"
    ],
    "files": [
      "AGENTS.md",
      "CONTRIBUTING.md",
      "pyproject.toml",
      "setup.cfg",
      ".pre-commit-config.yaml",
      "runtests.sh",
      "requirements-dev.txt",
      "requirements.txt",
      "tests/test_utils.py",
      "tests/min_tests.py",
      "tests/__init__.py",
      "tests/lazy_transforms_utils.py"
    ]
  },
  "everyday": {
    "prefixes": [
      ".cursor/",
      "docs/",
      "monai/",
      "tests/",
      ".github/"
    ],
    "files": [
      "AGENTS.md",
      "CONTRIBUTING.md",
      "pyproject.toml",
      "setup.cfg",
      ".pre-commit-config.yaml",
      "runtests.sh",
      "requirements-dev.txt",
      "requirements.txt",
      "tests/test_utils.py",
      "tests/min_tests.py",
      "tests/__init__.py",
      "tests/lazy_transforms_utils.py",
      "LICENSE",
      "README.md",
      "CODE_OF_CONDUCT.md",
      "CITATION.cff",
      "Dockerfile",
      "Dockerfile.slim"
    ]
  },
  "deny_msg": "Blocked by MONAI_CURSOR_BOUNDARY=strict. Stay within transforms + kit paths (.cursor/, AGENTS.md, docs/cursor-kit/, monai/transforms/, tests/transforms/) or set MONAI_CURSOR_BOUNDARY=everyday. See AGENTS.md.",
  "warn_msg": "Warning: path/command is outside the everyday Cursor-kit allowlist. Prefer monai/, tests/, docs/, .cursor/. See AGENTS.md.",
  "prompt_coach": {
    "patterns": [
      {
        "pattern": "soft[\\s_-]?clip",
        "guidance": "Soft-clip intensity already exists in MONAI: use `ClipIntensityPercentiles` (with `sharpness_factor`) or the `soft_clip` util. Please rephrase around the existing API instead of adding `SoftClipIntensity`."
      }
    ]
  },
  "nudge": {
    "globs": [
      "monai/transforms/**/*.py",
      "tests/transforms/**/*.py"
    ],
    "message": "Cursor-kit nudge: you edited a transforms/tests file. Before handing off, run `./runtests.sh --ruff` and a scoped module test (e.g. `python -m tests.transforms.test_<name>`), and `bash docs/cursor-kit/scripts/check-deprecations.sh` for deprecated APIs."
  },
  "sync_check": {
    "paths": [
      "AGENTS.md",
      ".cursor/pack.config.json",
      ".cursor/boundary-profile",
      ".cursor/refs/transforms-array-dict.md",
      ".cursor/refs/testing.md",
      ".cursor/refs/contributing-checklist.md",
      ".cursor/refs/deprecations.md",
      ".cursor/refs/losses.md",
      ".cursor/refs/metrics.md",
      ".cursor/refs/networks.md",
      ".cursor/usage",
      "docs/cursor-kit/README.md",
      "docs/cursor-kit/DEMO.md",
      "docs/cursor-kit/EVALUATION.md",
      "docs/cursor-kit/scripts/sync-check.sh",
      "docs/cursor-kit/scripts/check-deprecations.sh",
      "docs/cursor-kit/scripts/check-changelog.sh",
      "docs/cursor-kit/scripts/ledger-report.py",
      "docs/cursor-kit/scripts/ledger-dashboard.py",
      "docs/cursor-kit/scripts/ledger-dashboard-plain.py",
      "docs/cursor-kit/scripts/score_tdd_gate.py",
      "docs/cursor-kit/productization/manifest.json",
      "docs/cursor-kit/productization/PRODUCTIZATION.md",
      ".github/workflows/cursor-kit-sync.yml"
    ]
  },
  "tdd": {
    "artifact_paths": {
      "spec": "docs/cursor-kit/work/{issue}/SPEC.md",
      "review": "docs/cursor-kit/work/{issue}/SPEC-REVIEW.md",
      "test": "tests/transforms/test_robust_scale_intensity.py"
    }
  },
  "spec_critic": {
    "required_verdict_token": "Approve",
    "rubric": [
      "problem_clarity",
      "acceptance_testability",
      "scope_fit",
      "touch_path_realism",
      "risk_and_non_goals"
    ]
  },
  "judge": {
    "rubric": [
      {
        "dimension": "acceptance_alignment",
        "weight": 0.3
      },
      {
        "dimension": "test_coverage",
        "weight": 0.25
      },
      {
        "dimension": "scope_discipline",
        "weight": 0.25
      },
      {
        "dimension": "reviewability",
        "weight": 0.2
      }
    ]
  }
}
