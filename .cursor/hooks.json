{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/session_start.py"
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 .cursor/hooks/boundary_read.py",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/boundary_shell.py",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/nudge_style_test.py"
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/post_edit_nudge.py"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 .cursor/hooks/prompt_coach.py"
      }
    ],
    "subagentStart": [
      {
        "command": "python3 .cursor/hooks/subagent_audit.py"
      }
    ],
    "subagentStop": [
      {
        "command": "python3 .cursor/hooks/subagent_audit.py"
      }
    ]
  }
}
